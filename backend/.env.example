# Environment Mode (development, test, production)
NODE_ENV=production

# The port your server will run on (Usually provided dynamically in production)
PORT=5000

# Database Configuration (SECRET)
# Do NOT commit the real production URI
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dictionary?retryWrites=true&w=majority

# CORS Configuration (Comma-separated list of allowed origins)
# For production, strictly define your frontend domain.
ALLOWED_ORIGINS=https://english-dictionary-red.vercel.app

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
